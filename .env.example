# Amar Tax AI Agent - Environment Configuration

# Primary LLM API Keys (Provide at least one)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional LLM Model Override (e.g. gemini/gemini-3.5-flash-lite, groq/openai/gpt-oss-120b, gpt-4o-mini)
MODEL_NAME=gemini/gemini-3.5-flash-lite

# Simulated Remote Tax API Endpoint (for Fallback demonstration)
NBR_TAX_API_URL=https://nbr.gov.bd/api/v1/tax_rules_2026.json
